#!/bin/sh
# ai-backup run|status: encrypted backup of secrets and state (JSON output).
# Installed as /usr/local/sbin/ai-backup; the logic is ai_ops_agent/backup.py,
# run with the system python3 (standard library plus openssl, no bot credentials).
APP_DIR="${AI_OPS_AGENT_DIR:-/opt/ai-ops-agent}"
exec /usr/bin/env python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from ai_ops_agent.backup import main
sys.exit(main(sys.argv[2:]))
' "$APP_DIR" "$@"
